{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KollelSys Student Kiosk",
  "version": "0.1.0",
  "identifier": "com.kollelsys.student.kiosk",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../.output/public",
    "beforeDevCommand": "npm run kiosk:dev",
    "beforeBuildCommand": "npm run kiosk:generate"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KollelSys Student",
        "fullscreen": true,
        "decorations": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://kollelsys.com https://*.kollelsys.com",
        "img-src": "'self' data: blob: https://kollelsys.com https://*.kollelsys.com",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExNzI4NUYyN0JERjg5NTcKUldSWGlkOTc4b1Z5b1dtOEt5M3cvMUZaNitCcURMd1hjc1ErZkdlLy80WXBSYmtBNytzam5QeHIK",
      "endpoints": [
        "https://api.kollelsys.com/api/student-portal/desktop-updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
